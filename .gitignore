CTestTestfile.cmake
Makefile
.qtc/

# Qt generated files
moc_*.cpp
moc_*.h
qrc_*.cpp
ui_*.h
*_autogen/
.rcc/
.uic/

# Compiled output
*.exe
*.o
*.obj
*.pdb
*.ilk
*.dll
*.lib
